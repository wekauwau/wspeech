{
  "name": "@wspeech/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "codegen": "kysely-codegen --dialect postgres --out-file ../../packages/shared/src/db.ts --runtime-enums pascal-case"
  },
  "dependencies": {
    "@fastify/type-provider-zod": "^1.0.0",
    "@wspeech/shared": "workspace:*",
    "bcrypt": "^5.1.1",
    "fastify": "^5.11.2",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.2",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/pg": "^8.11.11",
    "kysely-codegen": "^0.20.0"
  }
}
