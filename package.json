    }
  },
  "scripts": {
    "dev:api": "pnpm --filter @wspeech/api dev",
    "dev:worker": "pnpm --filter @wspeech/worker dev",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
