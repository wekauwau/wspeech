{
  "name": "wspeech",
  "private": true,
  "version": "0.0.0",
  "description": "Text-to-Speech-as-a-Service backend",
  "author": "wekauwau",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev:api": "pnpm --filter @wspeech/api dev",
    "dev:worker": "pnpm --filter @wspeech/worker dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "pnpm --filter @wspeech/api codegen",
    "db:push": "atlas schema apply --url \"$DATABASE_URL&search_path=public\" --to file://schema --dev-url 'docker://postgres/17?search_path=public' --auto-approve",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
