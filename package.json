{
  "name": "wspeech",
  "private": true,
  "version": "0.0.0",
  "description": "Text-to-Speech-as-a-Service backend",
  "author": "wekauwau",
  "license": "ISC",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
